# Site
NEXT_PUBLIC_SITE_URL=https://umaidsadiq.com

# CMS database (Supabase) — both values are public by design.
# Settings → API in the Supabase dashboard.
# Do NOT add the service_role key here; it bypasses Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Lead delivery (Resend) — server-only
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Umaid Sadiq <hello@umaidsadiq.com>"
INQUIRY_TO=hello@umaidsadiq.com

# Conversion ladder (public)
NEXT_PUBLIC_BOOKING_URL=https://cal.com/umaidsadiq/consultation
# Digits only, including country code, no + or spaces.
# Optional — content/site.ts already defaults to the real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=923308738597
NEXT_PUBLIC_WHATSAPP_PREFILL=Hi Umaid, I'd like to discuss a project.

# Analytics (public)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
